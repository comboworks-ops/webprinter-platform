{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/api/favicon"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/api/robots"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/$",
      "dest": "/api/tenant-shell?pathname=/"
    },
    {
      "src": "^/(kontakt|om-os|vilkaar|betingelser|privatliv|shop|produkter|prisberegner|grafisk-vejledning)/?$",
      "dest": "/api/tenant-shell?pathname=/$1"
    },
    {
      "src": "^/produkt/([^/?]+)/?$",
      "dest": "/api/tenant-shell?pathname=/produkt/$1"
    },
    {
      "src": "^/llms\\.txt$",
      "dest": "/api/llms"
    },
    {
      "src": "^/(platform|priser|white-label|beregning|order-flow|online-designer|privacy-policy|handelsbetingelser|cookiepolitik|opret-shop)/?$",
      "dest": "/api/tenant-shell?pathname=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "installCommand": "npx --yes pnpm@11.19.0 install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm run build:test"
}
